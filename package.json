{
	"name": "pitch-recognizer",
	"version": "1.0.0",
	"description": "Web app that detects pitch from the microphone and turns ear training into a note-guessing game.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"check:pitch": "node scripts/pitch-check.ts",
		"check:chords": "node scripts/chord-check.ts",
		"check:scales": "node scripts/scale-check.ts",
		"check:tunings": "node scripts/tuning-check.ts",
		"bench": "node scripts/bench.ts"
	},
	"keywords": [
		"pitch",
		"pitch-detection",
		"music",
		"ear-training",
		"tuner",
		"web-audio"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"vexflow": "^4.2.5"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vite-plugin-pwa": "^1.3.0"
	}
}
