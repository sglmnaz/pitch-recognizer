{
	"name": "pitch-recognizer",
	"version": "1.0.0",
	"description": "Web app that detects pitch from the microphone and turns ear training into a note-guessing game.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome lint",
		"format": "biome format --write",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
		"check": "npm run check:pitch && npm run check:chords && npm run check:scales && npm run check:tunings && npm run check:metronome && npm run check:chord-theory && npm run check:ear && npm run check:chord-library && npm run check:harmony && npm run check:changes && npm run check:tab && npm run check:settings && npm run check:note-names && npm run check:i18n",
		"check:pitch": "node scripts/pitch-check.ts",
		"check:chords": "node scripts/chord-check.ts",
		"check:scales": "node scripts/scale-check.ts",
		"check:tunings": "node scripts/tuning-check.ts",
		"check:metronome": "node scripts/metronome-check.ts",
		"check:chord-theory": "node scripts/chord-theory-check.ts",
		"check:ear": "node scripts/ear-check.ts",
		"check:chord-library": "node scripts/chord-library-check.ts",
		"check:harmony": "node scripts/harmony-check.ts",
		"check:changes": "node scripts/changes-check.ts",
		"check:tab": "node scripts/tab-check.ts",
		"check:settings": "node scripts/settings-check.ts",
		"check:note-names": "node scripts/note-names-check.ts",
		"check:i18n": "node scripts/i18n-check.ts",
		"replay": "node scripts/replay.ts",
		"bench": "node scripts/bench.ts",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots"
	},
	"keywords": [
		"pitch",
		"pitch-detection",
		"music",
		"ear-training",
		"tuner",
		"web-audio"
	],
	"author": "",
	"license": "MIT",
	"browserslist": [
		"ios_saf >= 16.2",
		"safari >= 16.2",
		"last 2 chrome versions",
		"last 2 and_chr versions",
		"last 2 edge versions",
		"last 2 firefox versions",
		"last 2 and_ff versions"
	],
	"dependencies": {
		"vexflow": "^4.2.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"browserslist": "^4.29.4",
		"lightningcss": "^1.33.0",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vite-plugin-pwa": "^1.3.0"
	}
}
